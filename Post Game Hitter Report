def draw_spray_chart(ax, bip_data):
    ax.set_facecolor("#1a6e2e")

    foul_dist = 330
    lf_angle  = np.radians(90 + 45)
    rf_angle  = np.radians(90 - 45)

    ax.plot([0, foul_dist * np.cos(lf_angle)],
            [0, foul_dist * np.sin(lf_angle)],
            color="white", lw=1.8, zorder=3)
    ax.plot([0, foul_dist * np.cos(rf_angle)],
            [0, foul_dist * np.sin(rf_angle)],
            color="white", lw=1.8, zorder=3)

    arc_angles = np.linspace(rf_angle, lf_angle, 300)
    arc_dist = []
    for a in arc_angles:
        deg = np.degrees(a)
        if deg <= 50 or deg >= 130:
            arc_dist.append(330)
        elif 85 <= deg <= 95:
            arc_dist.append(400)
        else:
            arc_dist.append(330 + 70 * np.sin(np.radians((deg - 45) * 2)))
    arc_x = [arc_dist[i] * np.cos(arc_angles[i]) for i in range(len(arc_angles))]
    arc_y = [arc_dist[i] * np.sin(arc_angles[i]) for i in range(len(arc_angles))]
    ax.plot(arc_x, arc_y, color="white", lw=2, zorder=3)

    base_dist = 90
    home   = np.array([0, 0])
    first  = np.array([base_dist,  base_dist])
    second = np.array([0,          base_dist * 2])
    third  = np.array([-base_dist, base_dist])

    infield_circle = plt.Circle(
        (0, base_dist), 95,
        color="#c8a870", fill=True, zorder=2
    )
    ax.add_patch(infield_circle)

    diamond_path_verts = [
        (home[0],   home[1]),
        (first[0],  first[1]),
        (second[0], second[1]),
        (third[0],  third[1]),
        (home[0],   home[1]),
    ]
    codes = [Path.MOVETO, Path.LINETO, Path.LINETO, Path.LINETO, Path.CLOSEPOLY]
    clip_path  = Path(diamond_path_verts, codes)
    clip_patch = patches.PathPatch(clip_path, transform=ax.transData)
    infield_circle.set_clip_path(clip_patch)

    diamond_xs = [home[0], first[0], second[0], third[0], home[0]]
    diamond_ys = [home[1], first[1], second[1], third[1], home[1]]
    ax.plot(diamond_xs, diamond_ys, color="white", lw=1.8, zorder=4)

    mound = plt.Circle((0, 60.5), 9, color="#c8a870", fill=True, zorder=3)
    ax.add_patch(mound)

    ax.scatter([0], [0], s=75, color="white", zorder=5)

    if bip_data is not None and bip_data["direction"] is not None:
        direction_deg   = bip_data["direction"]
        distance        = bip_data["distance"]
        tagged_hit_type = bip_data.get("tagged_hit_type", "")
        is_groundball = "groundball" in tagged_hit_type.lower().replace(" ", "").replace("_", "")

        if is_groundball:
            hit_x, hit_y = project_to_infield_edge(direction_deg)
        elif distance is not None:
            plot_angle_rad = np.radians(90 - direction_deg)
            hit_x = distance * np.cos(plot_angle_rad)
            hit_y = distance * np.sin(plot_angle_rad)
        else:
            plot_angle_rad = np.radians(90 - direction_deg)
            hit_x = 150 * np.cos(plot_angle_rad)
            hit_y = 150 * np.sin(plot_angle_rad)

        ax.scatter(hit_x, hit_y, s=240, color="black",
                   edgecolors="white", linewidths=1.0, zorder=6)

    ax.set_xlim(-350, 350)
    ax.set_ylim(-20, 430)
    ax.set_aspect("equal")
    ax.set_xticks([])
    ax.set_yticks([])
    for spine in ax.spines.values():
        spine.set_edgecolor(UP_PURPLE)
        spine.set_linewidth(1.2)


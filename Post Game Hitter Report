def draw_hitter_summary_page(pdf, display_name, hitter_df, cols, page_num):
    results = hitter_df["PitchCall"].map(normalize_pitch_result)
    is_swing = results.isin(["Swing & Miss", "Foul Ball", "BIP"])
    is_taken = results.isin(["Ball", "Called Strike", "Int. Walk", "HBP"])
    is_whiff = results.eq("Swing & Miss")
    is_bip = results.eq("BIP")

    has_location = (
        hitter_df["PlateLocSide_num"].notna()
        & hitter_df["PlateLocHeight_num"].notna()
    )
    side_distance = (
        (SZ_LEFT - hitter_df["PlateLocSide_num"]).clip(lower=0)
        + (hitter_df["PlateLocSide_num"] - SZ_RIGHT).clip(lower=0)
    )
    height_distance = (
        (SZ_BOT - hitter_df["PlateLocHeight_num"]).clip(lower=0)
        + (hitter_df["PlateLocHeight_num"] - SZ_TOP).clip(lower=0)
    )
    in_zone = (
        has_location
        & hitter_df["PlateLocSide_num"].between(SZ_LEFT, SZ_RIGHT)
        & hitter_df["PlateLocHeight_num"].between(SZ_BOT, SZ_TOP)
    )
    inside_chase_window = (
        hitter_df["PlateLocSide_num"].between(
            SZ_LEFT - CHASE_MARGIN, SZ_RIGHT + CHASE_MARGIN
        )
        & hitter_df["PlateLocHeight_num"].between(
            SZ_BOT - CHASE_MARGIN, SZ_TOP + CHASE_MARGIN
        )
    )
    chase_eligible = has_location & ~inside_chase_window
    is_chase = is_swing & chase_eligible

    ev_col = cols.get("exit_speed")
    if ev_col and ev_col in hitter_df.columns:
        batted_balls = is_bip & hitter_df[ev_col].notna()
        hard_hit = batted_balls & hitter_df[ev_col].ge(95)
    else:
        batted_balls = pd.Series(False, index=hitter_df.index)
        hard_hit = batted_balls

    def format_rate(numerator, denominator):
        if denominator == 0:
            return "N/A", "0 / 0"
        return f"{100 * numerator / denominator:.1f}%", f"{numerator} / {denominator}"

    zone_rate = format_rate(int((is_swing & in_zone).sum()), int(in_zone.sum()))
    hard_hit_rate = format_rate(int(hard_hit.sum()), int(batted_balls.sum()))
    chase_rate = format_rate(int(is_chase.sum()), int(chase_eligible.sum()))
    whiff_rate = format_rate(int(is_whiff.sum()), int(is_swing.sum()))

    fig = plt.figure(figsize=(17, 15), facecolor="white")
    draw_page_header(fig, display_name, page_num)
    fig.text(
        0.5, 0.89, "Pitch Location Summary",
        ha="center", va="center", fontsize=18,
        fontweight="bold", color=UP_PURPLE
    )

    categories = [
        ("All Swings", is_swing),
        ("Chase", is_chase),
        ("Swing & Miss", is_whiff),
        ("All Taken", is_taken),
    ]
    heart = (
        in_zone
        & hitter_df["PlateLocSide_num"].between(
            SZ_LEFT + HEART_EDGE_INSET, SZ_RIGHT - HEART_EDGE_INSET
        )
    )
    edge_outer = (
        hitter_df["PlateLocSide_num"].between(
            SZ_LEFT - EDGE_OUTER_MARGIN, SZ_RIGHT + EDGE_OUTER_MARGIN
        )
        & hitter_df["PlateLocHeight_num"].between(
            SZ_BOT - EDGE_OUTER_MARGIN, SZ_TOP + EDGE_OUTER_MARGIN
        )
    )
    edge_inner = (
        hitter_df["PlateLocSide_num"].between(
            SZ_LEFT + EDGE_INNER_INSET, SZ_RIGHT - EDGE_INNER_INSET
        )
        & hitter_df["PlateLocHeight_num"].between(
            SZ_BOT + EDGE_INNER_INSET, SZ_TOP - EDGE_INNER_INSET
        )
    )
    edge = has_location & edge_outer & ~edge_inner
    swing_decision = pd.Series(np.where(is_swing, "Swing", "Taken"), index=hitter_df.index)
    decision_known = is_swing | is_taken
    heart_decision_score = int(is_swing.loc[heart & decision_known].sum()) - int(
        is_taken.loc[heart & decision_known].sum()
    )
    strikes_col = cols.get("strikes")
    if strikes_col and strikes_col in hitter_df.columns:
        strikes_before_pitch = pd.to_numeric(hitter_df[strikes_col], errors="coerce")
        edge_before_two_strikes = (
            edge & decision_known & strikes_before_pitch.isin([0, 1])
        )
        edge_with_two_strikes = edge & decision_known & strikes_before_pitch.eq(2)
    else:
        edge_before_two_strikes = pd.Series(False, index=hitter_df.index)
        edge_with_two_strikes = pd.Series(False, index=hitter_df.index)
    edge_decision_score = int(is_taken.loc[edge_before_two_strikes].sum()) - int(
        is_swing.loc[edge_before_two_strikes].sum()
    )
    decision_categories = [
        ("Dick Shot Decisions", heart, heart_decision_score, "heart"),
        (
            "Edge Decisions Before 2 Strikes",
            edge_before_two_strikes,
            edge_decision_score,
            "edge",
        ),
        (
            "Edge Decisions At 2 Strikes",
            edge_with_two_strikes,
            None,
            "edge",
        ),
    ]
    axes = [
        fig.add_axes([0.03, 0.50, 0.22, 0.28]),
        fig.add_axes([0.27, 0.50, 0.22, 0.28]),
        fig.add_axes([0.51, 0.50, 0.22, 0.28]),
        fig.add_axes([0.75, 0.50, 0.22, 0.28]),
        fig.add_axes([0.14, 0.14, 0.22, 0.28]),
        fig.add_axes([0.39, 0.14, 0.22, 0.28]),
        fig.add_axes([0.64, 0.14, 0.22, 0.28]),
    ]
    category_axes = (axes[0], axes[2], axes[3], axes[4])
    for ax, (title, category_mask) in zip(category_axes, categories):
        category_rows = hitter_df.loc[category_mask]
        located_rows = category_rows.loc[has_location.loc[category_rows.index]]
        draw_summary_strike_zone(
            ax, located_rows, title, int(category_mask.sum())
        )

    decision_axes = (axes[1], axes[5], axes[6])
    for ax, (title, area_mask, decision_score, decision_area) in zip(
        decision_axes, decision_categories
    ):
        decision_mask = area_mask & decision_known
        decision_rows = hitter_df.loc[decision_mask].copy()
        decision_rows["_Decision"] = swing_decision.loc[decision_rows.index]
        draw_summary_strike_zone(
            ax, decision_rows, title, int(decision_mask.sum()),
            decision_area=decision_area,
            decision_score=decision_score
        )

    pitch_types = sorted(
        {clean_str(pitch_type) or "Unknown" for pitch_type in hitter_df["PitchType"]},
        key=str.casefold,
    )
    legend_handles = [
        Line2D(
            [0], [0], marker="o", linestyle="none",
            markerfacecolor=get_color(pitch_type), markeredgecolor="white",
            markersize=8, label=pitch_type,
        )
        for pitch_type in pitch_types
    ]
    legend_handles.extend([
        Line2D(
            [0], [0], marker="o", linestyle="none", color="#222222",
            markersize=8, label="Swing",
        ),
        Line2D(
            [0], [0], marker="s", linestyle="none", color="#222222",
            markersize=8, label="Taken",
        ),
    ])
    fig.legend(
        handles=legend_handles,
        labels=[handle.get_label() for handle in legend_handles],
        loc="upper center", bbox_to_anchor=(0.5, 0.85),
        ncol=min(8, len(legend_handles)), frameon=False, fontsize=9,
        title="Pitch type / decision"
    )

    metric_text = (
        f"Zone Swing: {zone_rate[0]} ({zone_rate[1]})   |   "
        f"Hard-Hit (95+ mph): {hard_hit_rate[0]} ({hard_hit_rate[1]})   |   "
        f"Chase: {chase_rate[0]} ({chase_rate[1]})   |   "
        f"Whiff: {whiff_rate[0]} ({whiff_rate[1]})"
    )
    fig.text(
        0.5, 0.045, metric_text,
        ha="center", va="center", fontsize=13, color=UP_PURPLE
    )
    pdf.savefig(fig, facecolor=fig.get_facecolor())
    plt.close(fig)

def draw_contact_point(ax, pa_df, cols):
    """
    Bird's-eye contact point chart.

    Uses:
      ContactPositionZ = left/right across plate, 0 = middle of plate
      ContactPositionX = distance toward pitcher's mound from back point of plate

    Home plate point is drawn at the bottom of the graph.
    """
    ax.set_facecolor(UP_LIGHT)

    cx_col = cols.get("contact_x")
    cz_col = cols.get("contact_z")

    # Home plate dimensions in feet
    # 17 inches wide = 1.4167 ft
    plate_width = 17 / 12
    half_plate = plate_width / 2

    # Bird's-eye home plate.
    # Back point of plate is at bottom: (0, 0)
    # Front edge of plate is toward the mound, upward.
    plate_depth = 17 / 12
    side_depth  = 8.5 / 12

    plate_x = [
        -half_plate,
         half_plate,
         half_plate,
         0,
        -half_plate,
        -half_plate,
    ]

    plate_y = [
        plate_depth,
        plate_depth,
        side_depth,
        0,
        side_depth,
        plate_depth,
    ]

    # Fill plate white so it looks like a true bird's-eye home plate
    ax.fill(
        plate_x,
        plate_y,
        facecolor="white",
        edgecolor=UP_PURPLE,
        linewidth=2.0,
        zorder=1
    )

    # Subtle center line from back point toward mound
    ax.plot(
        [0, 0],
        [0, 4.0],
        color=UP_PURPLE,
        lw=1.0,
        alpha=0.35,
        zorder=0
    )

    valid_points = 0

    for i, (_, row) in enumerate(pa_df.iterrows(), start=1):
        if not cx_col or not cz_col:
            continue
        if cx_col not in row.index or cz_col not in row.index:
            continue

        contact_x = row[cx_col]
        contact_z = row[cz_col]

        if pd.notna(contact_x) and pd.notna(contact_z):
            valid_points += 1

            pt = row.get("PitchType", "")
            color = get_color(pt)

            # Bird's-eye view:
            # horizontal = inside/outside across plate
            # vertical = distance toward mound from back point of plate
            plot_x = float(contact_z)
            plot_y = float(contact_x)

            ax.scatter(
                plot_x,
                plot_y,
                s=160,
                color=color,
                edgecolors="white",
                linewidths=0.8,
                zorder=3
            )

            ax.text(
                plot_x + 0.05,
                plot_y + 0.05,
                str(i),
                fontsize=10,
                fontweight="bold",
                color=UP_PURPLE,
                bbox=dict(
                    facecolor="white",
                    edgecolor="none",
                    alpha=0.85,
                    boxstyle="round,pad=0.12"
                ),
                zorder=4
            )

    # Clean bird's-eye look: no title, no axes, no ticks
    ax.set_xticks([])
    ax.set_yticks([])
    ax.tick_params(left=False, bottom=False, labelleft=False, labelbottom=False)

    # Point of home plate at bottom, toward mound goes up
    ax.set_xlim(-2.3, 2.3)
    ax.set_ylim(-0.25, 4.0)
    ax.set_box_aspect(1)

    if valid_points == 0:
        ax.text(
            0.5, 0.5,
            "No Contact Data",
            transform=ax.transAxes,
            ha="center",
            va="center",
            color=UP_PURPLE,
            fontsize=12,
            fontweight="bold"
        )

    for spine in ax.spines.values():
        spine.set_edgecolor(UP_PURPLE)
        spine.set_linewidth(1.2)

def draw_pitch_table(ax, pa_df, cols):
    ax.axis("off")
    ax.set_facecolor("white")

    rel_speed_col = cols.get("rel_speed")

    rows = []
    for i, (_, row) in enumerate(pa_df.iterrows(), start=1):
        pt     = row.get("PitchType", "")
        abbr   = abbrev_pitch(pt)
        result = abbrev_result(normalize_pitch_result(row.get("PitchCall", "")))

        if rel_speed_col and rel_speed_col in row.index and pd.notna(row[rel_speed_col]):
            velo = f"{float(row[rel_speed_col]):.1f}"
        else:
            velo = "-"

        rows.append([str(i), abbr, velo, result])

    col_labels = ["#", "Type", "Velo", "Result"]

    row_colors = []
    for r in range(len(rows)):
        if r % 2 == 0:
            row_colors.append([UP_LIGHT] * len(col_labels))
        else:
            row_colors.append(["#ffffff"] * len(col_labels))

    tbl = ax.table(
        cellText=rows,
        colLabels=col_labels,
        cellLoc="center",
        colColours=[UP_PURPLE] * len(col_labels),
        cellColours=row_colors,
        bbox=[0, 0, 1, 1]
    )
    tbl.auto_set_font_size(False)

    if len(rows) <= 5:
        body_size, head_size = 15, 16
    elif len(rows) <= 7:
        body_size, head_size = 14, 15
    else:
        body_size, head_size = 13, 14

    tbl.set_fontsize(body_size)

    for (r, c), cell in tbl.get_celld().items():
        cell.set_edgecolor(UP_PURPLE)
        cell.set_linewidth(1.0)
        if r == 0:
            cell.set_text_props(color="white", weight="bold", fontsize=head_size)
        else:
            cell.set_text_props(color=UP_PURPLE)


def draw_at_bat_legends(fig, page_items):
    pitch_types = set()
    for item in page_items:
        if item["type"] != "ab":
            continue
        pa_df = item["h_df"]
        pa_df = pa_df[pa_df["_PA_ID"] == item["pa_id"]]
        pitch_types.update(
            clean_str(pitch_type) or "Unknown"
            for pitch_type in pa_df["PitchType"]
        )

    pitch_types = sorted(pitch_types, key=str.casefold)
    handles = [
        Line2D(
            [0], [0], marker="o", linestyle="none",
            markerfacecolor=get_color(pitch_type), markeredgecolor="white",
            markersize=8, label=pitch_type,
        )
        for pitch_type in pitch_types
    ]
    handles.extend([
        Line2D(
            [0], [0], marker="o", linestyle="none", color=UP_PURPLE,
            markersize=8, label="Swing",
        ),
        Line2D(
            [0], [0], marker="s", linestyle="none", color=UP_GRAY,
            markersize=8, label="Taken",
        ),
    ])
    fig.legend(
        handles=handles,
        labels=[handle.get_label() for handle in handles],
        loc="upper center", bbox_to_anchor=(0.5, 0.78),
        ncol=min(8, len(handles)), frameon=False, fontsize=9,
        title="Pitch type / decision",
    )


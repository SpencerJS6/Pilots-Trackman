def pick_first_existing(columns, candidates):
    for c in candidates:
        if c in columns:
            return c
    return None

def build_colmap(df):
    return {k: pick_first_existing(df.columns, v) for k, v in ALIASES.items()}

def clean_str(v):
    if pd.isna(v):
        return ""
    return str(v).strip()

def safe_filename(s):
    return re.sub(r'[\\/*?:"<>|]+', "_", str(s))

def format_name(name):
    name = clean_str(name)
    if not name:
        return "Unknown"
    if "," in name:
        last, first = [x.strip() for x in name.split(",", 1)]
        return f"{first} {last}"
    return name

def format_handedness(val, hitter=False):
    v = clean_str(val).upper()
    if v.startswith("R"):
        return "RHH" if hitter else "RHP"
    if v.startswith("L"):
        return "LHH" if hitter else "LHP"
    if v.startswith("S"):
        return "SHH" if hitter else "SHP"
    return "?" + ("HH" if hitter else "HP")

def get_color(pitch_type):
    pt = clean_str(pitch_type).lower()
    for key in PITCH_COLORS:
        if key in pt:
            return PITCH_COLORS[key]
    return "#999999"

def abbrev_pitch(pitch_type):
    pt = clean_str(pitch_type).lower()
    for key, abbr in PITCH_ABBREV.items():
        if key in pt:
            return abbr
    if pt:
        return pt[:2].upper()
    return "??"

def abbrev_result(result_str):
    r = result_str.lower().strip()
    for key, abbr in RESULT_ABBREV.items():
        if r == key:
            return abbr
    if "swing" in r or "miss" in r:
        return "S&M"
    if "called" in r and "strike" in r:
        return "CS"
    if "foul" in r:
        return "Foul"
    if "ball" in r:
        return "Ball"
    return result_str

def is_occupied(v):
    if pd.isna(v):
        return False
    if isinstance(v, bool):
        return v
    s = str(v).strip().lower()
    return s not in ("", "0", "false", "none", "nan")

def fmt_num(v, dec=1):
    if pd.isna(v):
        return None
    try:
        return f"{float(v):.{dec}f}"
    except:
        return None

def normalize_pitch_result(pitch_call):
    pc = clean_str(pitch_call).lower()

    if pc == "ballintentional":
        return "Int. Walk"
    if pc in ["ballcalled", "ballindirt", "ball in dirt"]:
        return "Ball"
    if pc == "strikecalled":
        return "Called Strike"
    if pc in ["foulball", "foulballnotfieldable", "foulballfieldable"]:
        return "Foul Ball"
    if pc == "inplay":
        return "BIP"
    if pc == "strikeswinging":
        return "Swing & Miss"
    if pc == "hitbypitch":
        return "HBP"

    if "foul" in pc:
        return "Foul Ball"
    if "swing" in pc:
        return "Swing & Miss"
    if "called" in pc and "strike" in pc:
        return "Called Strike"
    if "play" in pc:
        return "BIP"
    if "hit" in pc and "pitch" in pc:
        return "HBP"
    if "ball" in pc:
        return "Ball"

    return clean_str(pitch_call) if clean_str(pitch_call) else "Other"

def get_hit_type_prefix(tagged_hit_type):
    ht = clean_str(tagged_hit_type).lower().replace(" ", "").replace("_", "")
    for key, val in HIT_TYPE_MAP.items():
        if key in ht:
            return val
    return None

def derive_header_date(df_in, cols):
    if cols["game_date"] is None:
        return datetime.today().strftime("%m/%d/%Y")

    dt = pd.to_datetime(df_in[cols["game_date"]], errors="coerce").dropna()
    if len(dt) == 0:
        return datetime.today().strftime("%m/%d/%Y")

    dmin = dt.min().date()
    dmax = dt.max().date()

    if dmin == dmax:
        return pd.Timestamp(dmin).strftime("%m/%d/%Y")
    return f"{pd.Timestamp(dmin).strftime('%m/%d/%Y')} - {pd.Timestamp(dmax).strftime('%m/%d/%Y')}"

def build_game_key(df, cols):
    parts = []
    if cols["game_id"] and cols["game_id"] in df.columns:
        parts.append(df[cols["game_id"]].astype(str))
    if cols["game_date"] and cols["game_date"] in df.columns:
        date_part = pd.to_datetime(df[cols["game_date"]], errors="coerce").dt.strftime("%Y-%m-%d").fillna("")
        parts.append(date_part)

    if not parts:
        return pd.Series(["GAME"] * len(df), index=df.index)

    out = parts[0].copy()
    for p in parts[1:]:
        out = out.astype(str) + "|" + p.astype(str)
    return out

def sort_global_df(df, cols):
    if cols["top_bottom"] and cols["top_bottom"] in df.columns:
        df["_HALF_ORDER"] = df[cols["top_bottom"]].str.lower().str.startswith("top").map({True: 0, False: 1})

    sort_cols = []
    for c in [cols["game_date"], cols["game_id"], cols["inning"], "_HALF_ORDER",
              cols["pa_inning"], cols["pitch_no"], "_ROW_ORDER"]:
        if c and c in df.columns and c not in sort_cols:
            sort_cols.append(c)
    if "_ROW_ORDER" not in sort_cols:
        sort_cols.append("_ROW_ORDER")
    return df.sort_values(sort_cols, kind="mergesort").copy()

def derive_pa_ids(df, cols):
    df = df.copy()
    df["_ROW_ORDER"] = np.arange(len(df))

    if cols["pa_inning"] and cols["pa_inning"] in df.columns:
        game_key = build_game_key(df, cols).astype(str)
        inning = df[cols["inning"]].astype(str) if cols["inning"] else ""
        half   = df[cols["top_bottom"]].astype(str) if cols["top_bottom"] else ""
        batter = df[cols["hitter"]].astype(str) if cols["hitter"] else ""

        df["_PA_ID"] = (
            game_key.astype(str) + "|" +
            half.astype(str) + "|" +
            inning.astype(str) + "|" +
            df[cols["pa_inning"]].astype(str) + "|" +
            batter.astype(str)
        )
        return df

    sdf = sort_global_df(df, cols)
    game_key = build_game_key(sdf, cols)
    batter = sdf[cols["hitter"]].astype(str) if cols["hitter"] else pd.Series([""] * len(sdf), index=sdf.index)
    inning = sdf[cols["inning"]].astype(str) if cols["inning"] else pd.Series([""] * len(sdf), index=sdf.index)
    half   = sdf[cols["top_bottom"]].astype(str) if cols["top_bottom"] else pd.Series([""] * len(sdf), index=sdf.index)

    new_pa = (
        game_key.ne(game_key.shift()) |
        batter.ne(batter.shift()) |
        inning.ne(inning.shift()) |
        half.ne(half.shift())
    )

    sdf["_PA_NUM"] = new_pa.cumsum()
    sdf["_PA_ID"] = "PA_" + sdf["_PA_NUM"].astype(str)

    df = df.merge(sdf[["_ROW_ORDER", "_PA_ID"]], on="_ROW_ORDER", how="left")
    return df

def sort_pa_df(pa_df, cols):
    sort_cols = []
    for c in [cols["pitch_no"], "_ROW_ORDER"]:
        if c and c in pa_df.columns and c not in sort_cols:
            sort_cols.append(c)
    if not sort_cols:
        return pa_df.copy()
    return pa_df.sort_values(sort_cols, kind="mergesort").copy()

def build_ab_outcome(pa_df, cols):
    if pa_df.empty:
        return "N/A"

    last = pa_df.iloc[-1]
    pitch_call      = clean_str(last[cols["pitch_call"]])      if cols["pitch_call"]      else ""
    play_result     = clean_str(last[cols["play_result"]])     if cols["play_result"]     else ""
    korbb           = clean_str(last[cols["korbb"]])           if cols["korbb"]           else ""
    tagged_hit_type = clean_str(last[cols["tagged_hit_type"]]) if cols["tagged_hit_type"] else ""

    if normalize_pitch_result(pitch_call) == "HBP":
        return "Hit By Pitch"

    kl = korbb.lower()
    if "walk" in kl or kl == "bb":
        return "Walk"
    if "strikeout" in kl or kl == "k":
        return "Strikeout"

    if normalize_pitch_result(pitch_call) == "BIP" or play_result:
        pr = play_result if play_result else "Ball In Play"
        pr_lower = pr.lower().strip()

        hit_prefix = get_hit_type_prefix(tagged_hit_type)
        if hit_prefix and ("out" in pr_lower):
            pr = f"{hit_prefix} Out"
        elif hit_prefix and pr_lower in ("", "undefined", "ball in play"):
            pr = f"{hit_prefix} Ball"

        ev_col = cols["exit_speed"]
        ev = fmt_num(last[ev_col], 1) if ev_col and ev_col in last.index else None

        if ev:
            return f"{pr}\nEV: {ev}"
        return pr

    return normalize_pitch_result(pitch_call)

def inning_label(row, cols):
    inn  = clean_str(row[cols["inning"]])             if cols["inning"]     else "?"
    half = clean_str(row[cols["top_bottom"]]).lower() if cols["top_bottom"] else ""

    if half.startswith("top"):
        half_txt = "Top"
    elif half.startswith("bot"):
        half_txt = "Bot"
    else:
        half_txt = ""

    return f"{half_txt} {inn}".strip()

def project_to_infield_edge(direction_deg):
    """
    Project a ground ball to the edge of the infield diamond.
    Returns (x, y) at the intersection of the direction ray with the diamond boundary.
    """
    angle_rad = np.radians(90 - direction_deg)
    dx = np.cos(angle_rad)
    dy = np.sin(angle_rad)

    base_dist = 90
    home   = np.array([0.0, 0.0])
    first  = np.array([base_dist,  base_dist])
    second = np.array([0.0,        base_dist * 2])
    third  = np.array([-base_dist, base_dist])

    edges = [
        (home,  first),
        (first, second),
        (second,third),
        (third, home),
    ]

    best_t     = None
    best_point = None

    for (p1, p2) in edges:
        ex = p2[0] - p1[0]
        ey = p2[1] - p1[1]

        denom = dx * ey - dy * ex
        if abs(denom) < 1e-10:
            continue

        tx = p1[0] - home[0]
        ty = p1[1] - home[1]

        t = (tx * ey - ty * ex) / denom
        s = (tx * dy - ty * dx) / denom

        if t > 0.01 and 0.0 <= s <= 1.0:
            if best_t is None or t < best_t:
                best_t     = t
                best_point = (home[0] + t * dx, home[1] + t * dy)

    if best_point is None:
        best_point = (dx * 60, dy * 60)

    return best_point

def get_bip_data(pa_df, cols):
    last = pa_df.iloc[-1]
    pitch_call  = clean_str(last[cols["pitch_call"]]) if cols["pitch_call"] else ""
    play_result = clean_str(last[cols["play_result"]]) if cols["play_result"] else ""

    is_bip = normalize_pitch_result(pitch_call) == "BIP" or bool(play_result)
    if not is_bip:
        return None

    dir_col      = cols.get("direction")
    dist_col     = cols.get("distance")
    ev_col       = cols.get("exit_speed")
    la_col       = cols.get("launch_angle")
    hit_type_col = cols.get("tagged_hit_type")

    direction       = float(last[dir_col])          if dir_col      and dir_col      in last.index and pd.notna(last[dir_col])      else None
    distance        = float(last[dist_col])         if dist_col     and dist_col     in last.index and pd.notna(last[dist_col])     else None
    ev              = float(last[ev_col])            if ev_col       and ev_col       in last.index and pd.notna(last[ev_col])       else None
    la              = float(last[la_col])            if la_col       and la_col       in last.index and pd.notna(last[la_col])       else None
    tagged_hit_type = clean_str(last[hit_type_col]) if hit_type_col and hit_type_col in last.index                                  else ""

    return {
        "direction":       direction,
        "distance":        distance,
        "ev":              ev,
        "la":              la,
        "play_result":     play_result,
        "tagged_hit_type": tagged_hit_type,
    }


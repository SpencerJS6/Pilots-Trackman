    df["PlateLocHeight_num"] = pd.to_numeric(df[cols["plate_z"]], errors="coerce")
else:
    df["PlateLocHeight_num"] = np.nan

for col_key in ["exit_speed", "launch_angle", "direction", "distance",
                "rel_speed", "inning", "pa_inning", "pitch_no", "balls",
                "strikes", "outs",
                "contact_x", "contact_z"]:
    if cols[col_key]:
        df[cols[col_key]] = pd.to_numeric(df[cols[col_key]], errors="coerce")

# Derive PA IDs and sort
df = derive_pa_ids(df, cols)
df = sort_global_df(df, cols)

# ── TEAM GROUPING ─────────────────────────────────────────────────────────────
team_col = cols.get("batter_team")

if team_col and team_col in df.columns:
    unique_teams = df[team_col].dropna().astype(str).unique().tolist()
    if len(unique_teams) >= 2:
        # Let the user choose mode: separate per-team, combined, or pick specific teams
        numbered = "\n".join([f"{i+1}: {t}" for i, t in enumerate(unique_teams)])
        prompt_text = (
            f"Found teams:\n{numbered}\n\n"
            "Options:\n"
            "  s  = separate per-team PDFs (one file per team)\n"
            "  c  = combined report for All Hitters\n"
            "  or enter comma-separated team numbers or names to generate only those teams.\n"
            "Examples: 's', 'c', '1', '2,3', 'Team Name'\n"
            "Default: 's'\n"
        )

        try:
            import tkinter as tk
            from tkinter import simpledialog

            root = tk.Tk()
            root.withdraw()
            choice = simpledialog.askstring("Team Mode", prompt_text)
            root.destroy()
        except Exception:
            choice = input(prompt_text + "Choice: ").strip()

        if not choice:
            choice = "s"

        choice_str = str(choice).strip()

        if choice_str.lower().startswith("c"):
            df["_TEAM"] = "All Hitters"
            team_col = "_TEAM"
            teams = ["All Hitters"]
        elif choice_str.lower().startswith("s"):
            teams = unique_teams
        else:
            # Try parse numeric indices
            picked = []
            parts = [p.strip() for p in choice_str.split(",") if p.strip()]
            for p in parts:
                if p.isdigit():
                    idx = int(p) - 1
                    if 0 <= idx < len(unique_teams):
                        picked.append(unique_teams[idx])
                else:
                    # try match by name (case-insensitive)
                    for t in unique_teams:
                        if t.lower() == p.lower():
                            picked.append(t)
                            break

            teams = picked if picked else unique_teams
    else:
        teams = unique_teams
else:
    df["_TEAM"] = "All Hitters"
    team_col = "_TEAM"
    teams = ["All Hitters"]

today_file  = datetime.today().strftime("%Y-%m-%d")
csv_basename = os.path.splitext(os.path.basename(CSV_PATH))[0]
header_date = derive_header_date(df, cols)

# ── BUILD ONE PDF PER TEAM ────────────────────────────────────────────────────
for team_name in sorted(teams):
    team_df = df[df[team_col].astype(str) == team_name].copy()
    if team_df.empty:
        continue

    hitter_order = team_df[cols["hitter"]].astype(str).drop_duplicates().tolist()

    hitter_blocks = []
    for hitter_raw in hitter_order:
        h_df = team_df[team_df[cols["hitter"]].astype(str) == hitter_raw].copy()
        if h_df.empty:
            continue

        pa_ids = h_df["_PA_ID"].dropna().drop_duplicates().tolist()
        if not pa_ids:
            continue

        display_name = format_name(hitter_raw)

        if cols["batter_side"] and cols["batter_side"] in h_df.columns:
            first_side = h_df[cols["batter_side"]].dropna()
            hitter_side = format_handedness(first_side.iloc[0], hitter=True) if len(first_side) else "?HH"
        else:
            hitter_side = "?HH"

        hitter_blocks.append({
            "hitter_raw":   hitter_raw,
            "display_name": display_name,
            "hitter_side":  hitter_side,
            "pa_ids":       pa_ids,
            "h_df":         h_df,
        })

    if not hitter_blocks:
        print(f"⚠️  Skipped team {team_name}: no at-bats found")
        continue

    # ── Build pages — each hitter gets their own page(s) ────────────────────
    # Each hitter block becomes its own set of pages
    # Never mix two hitters on the same page

    safe_team = safe_filename(team_name.replace(" ", "_"))
    # Filename uses team name and current date (YYYY-MM-DD)
    out_path  = os.path.join(OUTPUT_DIR, f"{safe_team}_{today_file}_hitter_report.pdf")

    with PdfPages(out_path) as pdf:
        for block in hitter_blocks:
            hitter_raw   = block["hitter_raw"]
            display_name = block["display_name"]
            hitter_side  = block["hitter_side"]
            pa_ids       = block["pa_ids"]
            h_df         = block["h_df"]

            # Split this hitter's PA ids into chunks of ABS_PER_PAGE
            pa_chunks = [
                pa_ids[i:i + ABS_PER_PAGE]
                for i in range(0, len(pa_ids), ABS_PER_PAGE)
            ]

            for chunk_idx, chunk in enumerate(pa_chunks):
                page_num = chunk_idx + 1

                # Build page items — header row + AB rows
                page_items = []

                # Always add section header on first page of hitter
                # On subsequent pages just show their name in header bar
                page_items.append({
                    "type":         "header",
                    "display_name": display_name,
                    "hitter_side":  hitter_side,
                })
                page_items.append({"type": "legend"})

                ab_num_offset = chunk_idx * ABS_PER_PAGE
                for ab_idx, pa_id in enumerate(chunk):
                    page_items.append({
                        "type":         "ab",
                        "pa_id":        pa_id,
                        "display_name": display_name,
                        "hitter_side":  hitter_side,
                        "ab_num":       ab_num_offset + ab_idx + 1,
                        "h_df":         h_df,
                    })

                n_abs = sum(1 for it in page_items if it["type"] == "ab")
                if n_abs == 0:
                    continue

                HEADER_WEIGHT = 0.18
                row_heights = []
                for it in page_items:
                    if it["type"] == "header":
                        row_heights.append(HEADER_WEIGHT)
                    elif it["type"] == "legend":
                        row_heights.append(0.65)
                    else:
                        row_heights.append(1.0)

                fig = plt.figure(figsize=(17, 14.5), facecolor="white")

                # Always show hitter name in page header
                draw_page_header(fig, display_name, page_num)
                draw_at_bat_legends(fig, page_items)

                gs = gridspec.GridSpec(
    len(page_items), 5,
    figure=fig,
    width_ratios=[1.05, 1.05, 1.15, 0.85, 1.05],
    height_ratios=row_heights,
    left=0.01,
    right=0.99,
    top=0.90,
    bottom=0.04,
    wspace=0.07,
    hspace=0.16
)

                for row_idx, item in enumerate(page_items):

                    if item["type"] == "header":
                        draw_hitter_section_header(
                            fig, gs, row_idx,
                            item["display_name"],
                            item["hitter_side"],
                            header_date
                        )
                        continue

                    if item["type"] == "legend":
                        continue

                    pa_id  = item["pa_id"]
                    ab_num = item["ab_num"]

                    pa_df = h_df[h_df["_PA_ID"] == pa_id].copy()
                    if pa_df.empty:
                        continue

                    pa_df = sort_pa_df(pa_df, cols)

                    ax_zone    = fig.add_subplot(gs[row_idx, 0])
                    ax_contact = fig.add_subplot(gs[row_idx, 1])
                    ax_tbl     = fig.add_subplot(gs[row_idx, 2])
                    ax_info    = fig.add_subplot(gs[row_idx, 3])
                    ax_spray   = fig.add_subplot(gs[row_idx, 4])

                    draw_strike_zone_ab(ax_zone, pa_df)
                    draw_contact_point(ax_contact, pa_df, cols)
                    draw_pitch_table(ax_tbl, pa_df, cols)
                    draw_info_box(ax_info, pa_df, cols, ab_num)

                    bip_data = get_bip_data(pa_df, cols)
                    draw_spray_chart(ax_spray, bip_data)

                pdf.savefig(fig, facecolor=fig.get_facecolor())
                plt.close(fig)

            draw_hitter_summary_page(
                pdf, display_name, h_df, cols, len(pa_chunks) + 1
            )

        print(f"✅  Saved: {out_path}")

print(f"\n🎉  Done! {len(teams)} team PDF(s) saved to '{OUTPUT_DIR}/'")

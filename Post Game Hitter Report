def get_csv_path():
    try:
        import tkinter as tk
        from tkinter import filedialog

        root = tk.Tk()
        root.withdraw()
        path = filedialog.askopenfilename(
            title="",
            filetypes=[("CSV files", "*.csv"), ("All files", "*.*")]
        )
        root.destroy()
        if path and path.strip():
            return path
    except Exception:
        # If GUI isn't available or tkinter fails, fall back to console input
        pass

    path = input("Enter path to CSV file (or press Enter to cancel): ").strip()
    if not path:
        raise SystemExit("No CSV path provided.")
    return path


